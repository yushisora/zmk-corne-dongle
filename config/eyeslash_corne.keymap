#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
};

&lt {
    flavor = "tap-preferred";
};

#define MACRO(name,...) \
/ { \
  macros { \
    name: name { \
      compatible = "zmk,behavior-macro"; \
      #binding-cells = <0>; \
      __VA_ARGS__ \
    }; \
  }; \
};

#define MOD_FUNCTION(NAME, MOD, BINDING, MOD_BINDING) \
/ { \
  behaviors { \
    NAME: NAME { \
      compatible = "zmk,behavior-mod-morph"; \
      #binding-cells = <0>; \
      bindings = <BINDING>, <MOD_BINDING>; \
      mods = <(MOD_L##MOD|MOD_R##MOD)>; \
    }; \
  }; \
};

#define MOD_MACRO(NAME, MOD, BINDING, MOD_BINDING) \
MACRO(macro_ ## NAME, wait-ms = <0>; bindings = <MOD_BINDING>;) \
MOD_FUNCTION(NAME, MOD, BINDING, &macro_ ## NAME)

MOD_FUNCTION(bt_tog_clr, SFT, &out OUT_TOG, &bt BT_CLR)

MOD_MACRO(bt_sel_0, SFT,  &bt BT_SEL 0, &bt BT_SEL 0 &bt BT_CLR)
MOD_MACRO(bt_sel_1, SFT,  &bt BT_SEL 1, &bt BT_SEL 1 &bt BT_CLR)
MOD_MACRO(bt_sel_2, SFT,  &bt BT_SEL 2, &bt BT_SEL 2 &bt BT_CLR)
MOD_MACRO(bt_sel_3, SFT,  &bt BT_SEL 3, &bt BT_SEL 3 &bt BT_CLR)

MOD_FUNCTION(rgb_eft, SFT, &rgb_ug RGB_EFF, &rgb_ug RGB_EFR)
MOD_FUNCTION(rgb_hue, SFT, &rgb_ug RGB_HUI, &rgb_ug RGB_HUD)
MOD_FUNCTION(rgb_sat, SFT, &rgb_ug RGB_SAI, &rgb_ug RGB_SAD)
MOD_FUNCTION(rgb_brg, SFT, &rgb_ug RGB_BRI, &rgb_ug RGB_BRD)
MOD_FUNCTION(rgb_spe, SFT, &rgb_ug RGB_SPI, &rgb_ug RGB_SPD)

/ {
    rsr_vol: rsr_vol {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
        tap-ms = <5>;
        cw-binding = <&kp C_VOL_UP>;
        ccw-binding = <&kp C_VOL_DN>;
    };

    rsr_zoom: rsr_zoom {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
        tap-ms = <5>;
        cw-binding = <&kp LC(EQUAL)>;
        ccw-binding = <&kp LC(MINUS)>;
    };

    rsr_scroll: rsr_scroll {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
        tap-ms = <5>;
        cw-binding = <&msc SCRL_DOWN>;
        ccw-binding = <&msc SCRL_UP>;
    };

    rsr_trans: rsr_trans {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
        tap-ms = <0>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q   &kp W   &kp E   &kp R   &kp T                           &kp UP                  &kp Y   &kp U   &kp I       &kp O   &kp P       &kp GRAVE
&mt LCTRL ESC   &kp A   &kp S   &kp D   &kp F   &kp G               &kp LEFT    &kp SPACE   &kp RIGHT   &kp H   &kp J   &kp K       &kp L   &kp SEMI    &kp SQT
&kp LSHIFT      &kp Z   &kp X   &kp C   &kp V   &kp B   &kp C_MUTE              &kp DOWN                &kp N   &kp M   &kp COMMA   &kp DOT &kp FSLH    &kp BSLH
                                &mo 1   &kp LGUI &kp SPACE                                              &kp BSPC &kp ENTER &kp LALT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        num {
            display-name = "Num";
            bindings = <
&trans  &none       &none       &none       &none       &none                           &kp PG_UP               &kp N7  &kp N8  &kp N9  &kp MINUS   &kp EQUAL   &kp GRAVE
&trans  &none       &none       &none       &mo 2       &none               &kp HOME    &kp SPACE   &kp END     &kp N4  &kp N5  &kp N6  &kp LBKT    &kp RBKT    &kp SQT
&trans  &none       &none       &none       &none       &none   &kp LC(N0)              &kp PG_DN               &kp N1  &kp N2  &kp N3  &kp DOT     &kp FSLH    &kp BSLH
                                &none       &trans      &trans                                                  &kp BSPC &kp N0 &kp COMMA
            >;
            sensor-bindings = <&rsr_zoom &rsr_trans>;
        };

        fn_num {
            display-name = "Fn";
            bindings = <
&trans  &none       &none       &none       &none       &none                        &kp C_VOL_UP            &kp F7  &kp F8  &kp F9  &none  &none   &none
&trans  &none       &none       &none       &none       &none            &kp C_PREV  &kp C_PP   &kp C_NEXT   &kp F4  &kp F5  &kp F6  &none  &none   &none
&trans  &none       &none       &none       &none       &none    &none               &kp C_VOL_DN            &kp F1  &kp F2  &kp F3  &none  &none   &none
                                &none       &trans      &trans                                               &kp F10 &kp F11 &kp F12
            >;
            sensor-bindings = <&rsr_zoom &rsr_trans>;
        };
    };
};
